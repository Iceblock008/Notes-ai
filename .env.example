# Video Notes AI - Environment Variables
# Copy this to .env and fill in your API keys

# Get from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Get from https://www.assemblyai.com/dashboard/api
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Optional: Use Google Vertex AI instead of direct API
# GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Server port (default: 8080)
PORT=8080

# Bind host. Keep 127.0.0.1 for personal/local use (private).
# Set HOST=0.0.0.0 when deploying to a cloud host so it is reachable.
HOST=127.0.0.1
